# QC Live Environment Configuration
# Copy this file to .env.local and update with your values

# Session Secret - Generate a strong 32+ character random string
# You can generate one using: openssl rand -base64 32
SESSION_SECRET=your-very-long-random-session-secret-here

# Authentication - Update with your credentials
# ADMIN_* is canonical; older AUTH_* variables are supported for compatibility.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$10$YourHashedPasswordHere

# Application Settings
NODE_ENV=production
PORT=3000
# FFmpeg encoder preset: faster uses more CPU efficiency; veryfast lowers CPU
# usage. Higher-quality presets require more worker capacity.
# FFMPEG_PRESET=faster
# Private PyRunner media-worker control plane. Keep the token server-side.
# MEDIA_WORKER_URL=https://worker.example.com
# MEDIA_WORKER_TOKEN=replace-with-a-long-random-token
# MEDIA_WORKER_MEDIA_ROOT=/srv/qc-live-media

# Upload Settings (optional - defaults shown)
# MAX_FILE_SIZE=5368709120  # 5GB in bytes
# UPLOAD_DIR=./uploads

# Database (optional - defaults to SQLite)
# DATABASE_URL=./data/streams.db

# Supabase channel connections (server-side only; never expose the service role key)
# Project ref: rirngdknrszxkgdjcrcv
# SUPABASE_URL=https://rirngdknrszxkgdjcrcv.supabase.co
# SUPABASE_ANON_KEY=your-public-supabase-anon-key
# Optional fixed callback URL; add this URL to Supabase Auth redirect URLs.
# SUPABASE_AUTH_REDIRECT_URL=https://your-domain.example.com/auth/login
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key
# Use a different strong value in production; it encrypts saved stream keys.
# CHANNEL_ENCRYPTION_SECRET=your-32-character-or-longer-secret

# Automatic channel OAuth (server-side only; never expose client secrets)
# APP_URL=https://your-vercel-domain.vercel.app
# YOUTUBE_CLIENT_ID=your-google-oauth-client-id
# YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
# TWITCH_CLIENT_ID=your-twitch-client-id
# TWITCH_CLIENT_SECRET=your-twitch-client-secret
# FACEBOOK_APP_ID=your-meta-app-id
# FACEBOOK_APP_SECRET=your-meta-app-secret
# Register these exact callback URLs in each provider app:
# https://your-vercel-domain.vercel.app/api/channels/oauth/callback?platform=youtube
# https://your-vercel-domain.vercel.app/api/channels/oauth/callback?platform=twitch
# https://your-vercel-domain.vercel.app/api/channels/oauth/callback?platform=facebook
